# ── Providers ─────────────────────────────────────────────────────────────
# At least ONE provider key is required to run the chat demo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollive
POSTGRES_DB=ollive
# Host-side URL (apps running on your machine). Inside compose: postgres:5432
DATABASE_URL=postgres://ollive:ollive@localhost:5432/ollive

# ── Kafka ─────────────────────────────────────────────────────────────────
# Host-side bootstrap (apps on your machine). Inside compose: kafka:9092
KAFKA_BROKERS=localhost:29092

# ── Ingestion ─────────────────────────────────────────────────────────────
# Shared secret the SDK sends as X-Ingest-Key. Real system: per-tenant keys.
INGEST_KEY=dev-ingest-key
# Where the SDK ships event batches. Inside compose: http://ingest:4318
INGEST_URL=http://localhost:4318

# ── SDK delivery tuning (optional; defaults per the spec) ─────────────────
# Flush cadence for buffered events: batch of SDK_MAX_BATCH or SDK_FLUSH_MS,
# whichever first. Lower SDK_FLUSH_MS for fresher dashboards; raise
# SDK_MAX_BUFFER / SDK_MAX_RETRIES to trade memory for fewer drops during
# ingest outages.
#SDK_FLUSH_MS=2000
#SDK_MAX_BATCH=50
#SDK_MAX_BUFFER=1000
#SDK_MAX_RETRIES=3

# ── Service ports ─────────────────────────────────────────────────────────
API_PORT=4000
INGEST_PORT=4318
WEB_PORT=3000

# ── Chat behavior ─────────────────────────────────────────────────────────
# Per-reply output cap. Set low (e.g. 100) to keep demo spend tiny.
CHAT_MAX_TOKENS=2048
# true → also redact PII in chat messages (domain data); telemetry previews
# are ALWAYS redacted in the worker regardless of this flag.
REDACT_MESSAGES=false

# ── Security guardrails ───────────────────────────────────────────────────
# Per-IP req/min on the chat API; per-key req/min on ingest (1 req = ≤50 events).
API_RATE_LIMIT=120
INGEST_RATE_LIMIT=600
# Hard per-generation ceiling (ms) — no stream may hold an SSE slot forever.
CHAT_TIMEOUT_MS=120000
# true → 400 chat inputs flagged by the prompt-injection heuristics
# (default false = detect + log + mark telemetry, don't block).
GUARDRAILS_BLOCK=false
# Comma-separated origin allowlist for the api (unset = allow all, dev only).
#CORS_ORIGIN=http://localhost:3000
